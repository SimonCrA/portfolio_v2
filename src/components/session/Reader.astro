---
// The `glow`-style reader pane shared by Posts, Sobre mí and Projects. Slots: `media` sits beside
// the title (an avatar), `actions` follows the lead (a button), the default slot is the prose body
// and `after` follows it outside the prose styles (comments). The content scrolls inside the pane;
// the pager bar stays at its bottom. A Post passes `toc`: its text then reads as an article, in
// one column with the index of its sections beside it.
import '../../styles/reader.css'
import type { TocItem } from '../../session/toc'

type Link = { label: string; href: string }
type FrontmatterValue = string | { text: string; datetime: string } | Link | Link[]

interface Props {
  as?: 'article' | 'section'
  file: string
  title: string
  titleId: string
  lead?: string
  frontmatter?: { key: string; value: FrontmatterValue }[]
  image?: string
  scrollLabel: string
  pager?: { href: string; label: string; info: string }
  toc?: TocItem[]
}

const { as: Tag = 'article', file, title, titleId, lead, frontmatter, image, scrollLabel, pager, toc } = Astro.props
const hasMedia = Astro.slots.has('media')
// A short Post needs no index.
const index = toc && toc.length >= 3 ? toc : undefined
---

<Tag class:list={['pane is-active reader', { 'is-article': toc }]} aria-labelledby={titleId}>
  <h2 class="pane-title">glow {file}</h2>
  <div class="pane-scroll" data-scroll-box tabindex="0" aria-label={scrollLabel}>
    <div class:list={['reader-layout', { 'has-toc': index }]}>
      <div class="reader-col">
        {
          frontmatter && (
            <div class="frontmatter">
              <div>{'---'}</div>
              {frontmatter.map(({ key, value }) => (
                <div><span class="k">{key}</span>: {typeof value === 'string' ? value : Array.isArray(value) ? <span>[{value.map((l, i) => <span><a href={l.href}>{l.label}</a>{i < value.length - 1 ? ', ' : null}</span>)}]</span> : 'href' in value ? <a href={value.href} target="_blank" rel="noopener">{value.label}</a> : <time datetime={value.datetime}>{value.text}</time>}</div>
              ))}
              <div>{'---'}</div>
            </div>
          )
        }
        <div class:list={['reader-head', { 'has-media': hasMedia }]}>
          <slot name="media" />
          <div class="reader-intro">
            <h1 class="reader-title" id={titleId}>{title}</h1>
            {lead && <p class="reader-lead">{lead}</p>}
            <slot name="actions" />
          </div>
        </div>
        {
          image && (
            <figure>
              <img src={image} alt="" loading="lazy" />
            </figure>
          )
        }
        {
          index && (
            <details class="toc toc-inline" open>
              <summary>índice ({index.length} secciones)</summary>
              <ol>
                {index.map((item) => (
                  <li><span class="branch">{item.branch}</span><a href={`#${item.slug}`}>{item.text}</a></li>
                ))}
              </ol>
            </details>
          )
        }
        <div class="prose">
          <slot />
        </div>
        <slot name="after" />
      </div>
      {
        index && (
          <nav class="toc toc-side" aria-label="Índice del post">
            <p class="toc-title">índice</p>
            <ol>
              {index.map((item) => (
                <li><span class="branch">{item.branch}</span><a href={`#${item.slug}`} data-toc-link={item.slug}>{item.text}</a></li>
              ))}
            </ol>
          </nav>
        )
      }
    </div>
  </div>
  {
    pager && (
      <div class="pagerbar">
        <a href={pager.href}>{pager.label}</a>
        <span>{pager.info}</span>
        <span class="pct" data-pct>
          0%
        </span>
      </div>
    )
  }
</Tag>

<script>
  import { readerScroller } from '../../session/client/scroll'
  import { perFrame } from '../../session/client/frame'
  // The pager shows how far the reader has scrolled: the pane on desktop, the page on phones.
  const update = () => {
    const pct = document.querySelector('[data-pct]')
    if (!pct) return
    const el = readerScroller()
    const [top, max] =
      el instanceof HTMLElement ? [el.scrollTop, el.scrollHeight - el.clientHeight] : [scrollY, document.documentElement.scrollHeight - innerHeight]
    pct.textContent = `${max > 0 ? Math.round((top / max) * 100) : 100}%`
  }
  // The index marks the section being read: the last heading that has reached the top of the view.
  const markSection = () => {
    const links = document.querySelectorAll<HTMLElement>('[data-toc-link]')
    if (!links.length) return
    const el = readerScroller()
    const top = (el instanceof HTMLElement ? el.getBoundingClientRect().top : 0) + 96
    let current = links[0].dataset.tocLink
    for (const link of links) {
      const heading = document.getElementById(link.dataset.tocLink ?? '')
      if (heading && heading.getBoundingClientRect().top <= top) current = link.dataset.tocLink
    }
    for (const link of links) {
      if (link.dataset.tocLink === current) link.setAttribute('aria-current', 'location')
      else link.removeAttribute('aria-current')
    }
  }
  const onScroll = () => {
    update()
    markSection()
  }
  document.addEventListener('scroll', perFrame(onScroll), { capture: true, passive: true })
  document.addEventListener('astro:page-load', onScroll)
  // The module can load after the first `astro:page-load` of a client navigation.
  onScroll()

  // Copy buttons on code blocks. Without JavaScript the code is still selectable.
  const addCopyButtons = () => {
    for (const block of document.querySelectorAll<HTMLElement>('.reader .code-block')) {
      if (block.querySelector('.code-copy')) continue
      const button = document.createElement('button')
      button.type = 'button'
      button.className = 'code-copy'
      button.textContent = '[copiar]'
      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(block.querySelector('pre')?.innerText ?? '')
        button.textContent = '[copiado]'
        button.dataset.copied = ''
        setTimeout(() => {
          button.textContent = '[copiar]'
          delete button.dataset.copied
        }, 1500)
      })
      block.append(button)
    }
  }
  document.addEventListener('astro:page-load', addCopyButtons)
  addCopyButtons()
</script>
