---
// Renders an icon grid from src/session/icons.ts as a crisp SVG. Fills are CSS variables
// (--px-<role>), so icons follow the palette. Decorative (aria-hidden) unless `label` is given.
import { ICONS, type IconName } from '../../session/icons'

interface Props {
  name: IconName
  scale?: number
  class?: string
  label?: string
}

const { name, scale = 3, class: className, label } = Astro.props
const rows: readonly string[] = ICONS[name]
const width = Math.max(...rows.map((r) => r.length))
const height = rows.length
const pixels = rows.flatMap((row, y) => [...row].flatMap((c, x) => (c === '.' ? [] : [{ x, y, role: c }])))
---

<svg
  viewBox={`0 0 ${width} ${height}`}
  width={width * scale}
  height={height * scale}
  shape-rendering="crispEdges"
  class:list={['pixel-art', `pixel-${name}`, className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {pixels.map((p) => <rect x={p.x} y={p.y} width="1" height="1" style={`fill:var(--px-${p.role})`} />)}
</svg>
