---
// figlet ANSI Shadow banner. Wide screens get the text itself; phones get the same letters drawn as an
// SVG (solid blocks plus an offset shadow), because phone fonts misalign box-drawing glyphs. Decorative.
const wide = `███████╗██╗███╗   ███╗ ██████╗ ███╗   ██╗████████╗███████╗ ██████╗██╗  ██╗
██╔════╝██║████╗ ████║██╔═══██╗████╗  ██║╚══██╔══╝██╔════╝██╔════╝██║  ██║
███████╗██║██╔████╔██║██║   ██║██╔██╗ ██║   ██║   █████╗  ██║     ███████║
╚════██║██║██║╚██╔╝██║██║   ██║██║╚██╗██║   ██║   ██╔══╝  ██║     ██╔══██║
███████║██║██║ ╚═╝ ██║╚██████╔╝██║ ╚████║   ██║   ███████╗╚██████╗██║  ██║
╚══════╝╚═╝╚═╝     ╚═╝ ╚═════╝ ╚═╝  ╚═══╝   ╚═╝   ╚══════╝ ╚═════╝╚═╝  ╚═╝`

// Solid blocks take the accent colour, shadow strokes stay muted.
const runs = wide.match(/█+|[^█]+/g)!.map((text) => ({ text, solid: text[0] === '█' }))

// The SVG: one cell per character, twice as tall as wide like a terminal cell; each run of blocks is
// one rectangle.
const rows = wide.split('\n')
const cols = Math.max(...rows.map((r) => r.length))
const blocks = rows
  .flatMap((row, y) => [...row.matchAll(/█+/g)].map((m) => `M${m.index} ${y * 2}h${m[0].length}v2h-${m[0].length}z`))
  .join('')
---

<pre class="banner banner-wide" aria-hidden="true">{runs.map((r) => (r.solid ? <b>{r.text}</b> : r.text))}</pre>
<svg class="banner-narrow" viewBox={`0 0 ${cols + 0.6} ${rows.length * 2 + 0.6}`} aria-hidden="true" focusable="false">
  <path d={blocks} transform="translate(0.6 0.6)" fill="var(--line)" />
  <path d={blocks} fill="var(--accent)" />
</svg>

<style>
  .banner {
    margin: 4px 0 6px;
    color: var(--dim);
    /* Atkinson has no box-drawing glyphs; use a system mono that does. */
    font-family: ui-monospace, Menlo, Consolas, 'DejaVu Sans Mono', monospace;
    font-size: clamp(6px, 0.78vw, 0.7333rem);
    line-height: 1.05;
    white-space: pre;
    overflow: hidden;
  }
  .banner b {
    color: var(--accent);
    font-weight: 400;
  }
  .banner-narrow {
    display: none;
    width: 100%;
    height: auto;
    margin: 4px 0 6px;
  }
  @media (max-width: 560px) {
    .banner-wide {
      display: none;
    }
    .banner-narrow {
      display: block;
    }
  }
</style>
