---
// Every page of the redesigned site renders inside this layout: one tmux session with a status line.
import '../styles/session.css'
import StatusBar from '../components/session/StatusBar.astro'
import { SITE_TITLE, SITE_DESCRIPTION } from '../config'
import type { WindowKey } from '../session/windows'

interface Props {
  current: WindowKey
  title?: string
  description?: string
  image?: string
}

const { current, title = SITE_TITLE, description = SITE_DESCRIPTION, image = '/profile_pic.webp' } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
  </head>
  <body>
    <slot />
    <StatusBar current={current} />
  </body>
</html>
