---
import SessionLayout from '../layouts/SessionLayout.astro'
---

<SessionLayout current="proyectos" title="Proyectos | Simonctech">
  <main class="window">
    <section class="pane is-active" aria-labelledby="pane-proyectos">
      <h2 class="pane-title" id="pane-proyectos">proyectos</h2>
      <p class="prompt-line">
        <span class="user">simon@simonctech</span>:<span class="path">~</span>$ <span class="cmd" data-cmd>eza -l --icons proyectos/</span>
      </p>
      <p class="out empty" data-empty>Los Proyectos llegarán pronto.</p>
      <p class="out note"># Simón los está escribiendo, uno por uno.</p>
    </section>
  </main>
</SessionLayout>

<style>
  .empty {
    margin-top: 12px;
  }
  .note {
    color: var(--dim);
    font-size: 13.5px;
  }
</style>
