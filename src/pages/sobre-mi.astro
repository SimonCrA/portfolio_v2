---
// Window 4: Sobre mí, a `glow`-style reader fed by src/content/about/sobre-mi.md.
import SessionLayout from '../layouts/SessionLayout.astro'
import PixelArt from '../components/session/PixelArt.astro'
import '../styles/reader.css'
import { CV_URL } from '../session/windows'
import { getAbout } from '../session/getAbout'
import { fmtDate } from '../session/date'

const entry = await getAbout()
const { name, intro, now, nowUpdated, uses, links } = entry.data
const { Content } = await entry.render()
---

<SessionLayout current="sobre-mi" title={`Sobre mí | ${name}`}>
  <main class="window reader-window">
    <section class="pane is-active reader" aria-labelledby="about-name">
      <h2 class="pane-title">glow sobre-mi.md</h2>
      <div class="head">
        <PixelArt name="avatar" scale={6} class="pixel-avatar" label="Avatar pixel de Simón" />
        <div class="intro">
          <h1 class="reader-title" id="about-name">{name}</h1>
          <p class="reader-lead">{intro}</p>
          <p><a class="button" href={CV_URL} target="_blank" rel="noopener">Descargar CV (pdf)</a></p>
        </div>
      </div>

      <div class="prose">
        <Content />

        <h2>Ahora</h2>
        <p data-now>{now}</p>
        <p class="stamp">actualizado el <time datetime={nowUpdated.toISOString().slice(0, 10)} data-now-updated>{fmtDate(nowUpdated)}</time></p>

        <h2>Con qué trabajo</h2>
        {
          uses.map((g) => (
            <>
              <h3>{g.group}</h3>
              <ul>
                {g.items.map((u) => (
                  <li>
                    <strong>{u.what}:</strong> {u.value}
                  </li>
                ))}
              </ul>
            </>
          ))
        }

        <h2>Dónde encontrarme</h2>
        <ul>
          {links.map((l) => <li><a href={l.href} target="_blank" rel="noopener">{l.label}</a></li>)}
        </ul>
      </div>
    </section>
  </main>
</SessionLayout>

<style>
  .head {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    margin-bottom: 24px;
  }
  .intro {
    min-width: 0;
  }
  @media (max-width: 560px) {
    .head {
      flex-direction: column;
    }
  }
  .reader-lead {
    margin: 0 0 16px;
  }
  .stamp {
    color: var(--dim);
    font-size: 13px;
  }
  .button {
    display: inline-block;
    padding: 4px 12px;
    background: var(--accent);
    color: var(--bg);
    font-weight: 700;
    text-decoration: none;
  }
  .button:hover,
  .button:focus-visible {
    background: var(--fg-bright);
  }
</style>
