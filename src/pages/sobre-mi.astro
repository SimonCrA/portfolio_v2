---
// Window 4: Sobre mí, a `glow`-style reader fed by src/content/about/sobre-mi.md.
import SessionLayout from '../layouts/SessionLayout.astro'
import PixelArt from '../components/session/PixelArt.astro'
import { CV_URL } from '../session/windows'
import { getAbout } from '../session/getAbout'

const entry = await getAbout()
const { name, now, uses, links } = entry.data
const { Content } = await entry.render()
---

<SessionLayout current="sobre-mi" title={`Sobre mí | ${name}`}>
  <main class="window window-about">
    <section class="pane is-active reader" aria-labelledby="about-name">
      <h2 class="pane-title">glow sobre-mi.md</h2>
      <div class="head">
        <PixelArt name="avatar" scale={6} class="pixel-avatar" label="Avatar pixel de Simón" />
        <div class="intro">
          <h1 id="about-name">{name}</h1>
          <div class="lead"><Content /></div>
          <p><a class="button" href={CV_URL} target="_blank" rel="noopener">Descargar CV (pdf)</a></p>
        </div>
      </div>

      <div class="prose">
        <h2>Ahora</h2>
        <p data-now>{now}</p>

        <h2>Uses</h2>
        <ul>
          {uses.map((u) => <li><strong>{u.what}:</strong> {u.value}</li>)}
        </ul>

        <h2>Dónde encontrarme</h2>
        <ul>
          {links.map((l) => <li><a href={l.href} target="_blank" rel="noopener">{l.label}</a></li>)}
        </ul>
      </div>
    </section>
  </main>
</SessionLayout>

<style>
  .window-about {
    align-content: start;
  }
  .reader {
    width: 100%;
    max-width: 82ch;
    margin: 0 auto;
    padding: 26px clamp(14px, 4vw, 44px) 40px;
  }
  .head {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    margin-bottom: 8px;
  }
  .intro {
    min-width: 0;
  }
  @media (max-width: 560px) {
    .head {
      flex-direction: column;
    }
  }
  h1 {
    margin: 0 0 8px;
    color: var(--accent);
    font-size: clamp(24px, 4vw, 32px);
    line-height: 1.25;
  }
  h1::before {
    content: '# ';
    color: var(--dim);
  }
  .lead :global(p) {
    margin: 0 0 16px;
    color: var(--aqua);
  }
  .button {
    display: inline-block;
    padding: 4px 12px;
    background: var(--accent);
    color: var(--bg);
    font-weight: 700;
    text-decoration: none;
  }
  .button:hover,
  .button:focus-visible {
    background: var(--fg-bright);
  }
  .prose {
    max-width: 72ch;
    font-size: 16.5px;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }
  .prose h2 {
    margin: 28px 0 8px;
    color: var(--accent);
    font-size: 1.25em;
    line-height: 1.3;
  }
  .prose h2::before {
    content: '## ';
    color: var(--dim);
  }
  .prose p {
    margin: 0 0 12px;
  }
  .prose ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .prose li::before {
    content: '- ';
    color: var(--green);
  }
  .prose strong {
    color: var(--fg-bright);
  }
  .prose a {
    color: var(--aqua);
  }
  .prose a:hover {
    color: var(--accent);
  }
</style>
