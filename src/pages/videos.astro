---
import SessionLayout from '../layouts/SessionLayout.astro'
---

<SessionLayout current="videos" title="Videos | Simonctech">
  <main class="window">
    <section class="pane is-active" aria-labelledby="pane-videos">
      <h2 class="pane-title" id="pane-videos">videos</h2>
      <p class="prompt-line">
        <span class="user">simon@simonctech</span>:<span class="path">~</span>$ <span class="cmd" data-cmd>ls -lt videos/</span>
      </p>
      <p class="out empty" data-empty>Los Videos llegarán pronto: aparecerán solos desde el canal de YouTube.</p>
    </section>
  </main>
</SessionLayout>

<style>
  .empty {
    margin-top: 12px;
  }
</style>
