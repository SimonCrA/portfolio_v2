---
// Window 3: the latest Videos from the YouTube channel, as a list. Each row opens the Video on YouTube.
// The build renders the list (it works without JavaScript); after load, the script below swaps in the
// fresh list from /api/videos.json when it differs (ADR 0003).
import SessionLayout from '../layouts/SessionLayout.astro'
import PromptLine from '../components/session/PromptLine.astro'
import VideoRow from '../components/session/VideoRow.astro'
import { CHANNEL_URL, getVideos } from '../session/videos'

const videos = await getVideos()
---

<SessionLayout current="videos" title="Videos | Simón Clemente" description="Los últimos videos del canal de YouTube de Simón Clemente sobre programación, backend y la terminal." markdown="/videos.md">
  <main class="window">
    <section class="pane is-active" aria-labelledby="pane-videos">
      <h1 class="pane-title" id="pane-videos">videos</h1>
      <PromptLine cmd="ls -lt videos/" search />
      <div class="pane-scroll" data-scroll tabindex="0" aria-label="Lista de videos">
        <ol class="entry-list" data-list data-videos>
          {videos.map((video) => <VideoRow video={video} />)}
        </ol>
        <template data-video-row><VideoRow /></template>
        <p class="out entry-empty" data-videos-empty hidden={videos.length > 0}>
          No pude traer los videos esta vez. Míralos directamente en <a href={CHANNEL_URL} target="_blank" rel="noopener">el canal de YouTube</a>.
        </p>
      </div>
    </section>
  </main>
</SessionLayout>

<script>
  import { fmtDate } from '../session/date'
  import { viewsLabel } from '../session/videos-format'
  import { refreshLists } from '../session/client/lists'

  interface Video {
    id: string
    title: string
    url: string
    date: string
    views: number
    short: boolean
    thumbnail: string
  }

  const signature = (v: Pick<Video, 'id' | 'title' | 'views'>) => `${v.id}|${v.title}|${v.views}`

  // Rebuild the rows from fresh data. Every value goes in through textContent or attributes.
  function render(list: HTMLElement, model: HTMLElement, videos: Video[]) {
    const selected = list.querySelector<HTMLElement>('a[aria-current="true"]')?.closest('li')?.dataset.id
    list.replaceChildren(
      ...videos.map((v) => {
        const li = model.cloneNode(true) as HTMLElement
        li.dataset.id = v.id
        li.dataset.signature = signature(v)
        li.querySelector('a')!.href = v.url
        li.querySelector('img')!.src = v.thumbnail
        li.querySelector('.title')!.textContent = v.title
        li.querySelector('.where')!.textContent = `youtube.com/${v.short ? 'shorts' : 'watch'}`
        li.querySelector('.kind')!.textContent = v.short ? 'short' : 'video'
        li.querySelector('.views')!.textContent = viewsLabel(v.views)
        const time = li.querySelector('time')!
        time.dateTime = new Date(v.date).toISOString()
        time.textContent = fmtDate(new Date(v.date))
        return li
      }),
    )
    // Keep the cursor on the same Video when it is still there.
    const keep = [...list.querySelectorAll<HTMLElement>(':scope > li')].find((li) => li.dataset.id === selected)
    keep?.querySelector('a')?.setAttribute('aria-current', 'true')
    refreshLists()
  }

  document.addEventListener('astro:page-load', async () => {
    const list = document.querySelector<HTMLElement>('[data-videos]')
    const model = document.querySelector<HTMLTemplateElement>('[data-video-row]')?.content.firstElementChild as HTMLElement | null
    if (!list || !model) return
    try {
      const r = await fetch('/api/videos.json')
      if (!r.ok) return
      const videos: Video[] = await r.json()
      if (!videos.length) return
      const shown = [...list.querySelectorAll<HTMLElement>(':scope > li')].map((li) => li.dataset.signature ?? '').join()
      if (videos.map(signature).join() !== shown) render(list, model, videos)
      document.querySelector<HTMLElement>('[data-videos-empty]')!.hidden = true
    } catch {
      // Offline or the endpoint failed: the list from the build stays.
    }
  })
</script>
