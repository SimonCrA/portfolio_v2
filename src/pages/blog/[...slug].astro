---
import type { CollectionEntry } from 'astro:content'
import { blogPosting, graph, website } from '../../session/schema'
import type { BlogSchema } from '../../content/config'
import SessionLayout from '../../layouts/SessionLayout.astro'
import Reader from '../../components/session/Reader.astro'
import { getSortedPosts, readingMinutes, seriesOf } from '../../session/posts'
import { fmtLongDate } from '../../session/date'
import { toc } from '../../session/toc'

export async function getStaticPaths() {
  const postEntries = await getSortedPosts()
  return postEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, series: seriesOf(entry, postEntries) },
  }))
}

interface Props {
  entry: CollectionEntry<'blog'>
  series: CollectionEntry<'blog'>[]
}

const { entry, series } = Astro.props
const post: BlogSchema = entry.data
const { Content, headings } = await entry.render()
const minutes = readingMinutes(entry)
const fecha = fmtLongDate(post.publishDate)
const file = `~/blog/${entry.slug}.md`
---

<SessionLayout
  current="blog"
  title={`${post.title} | Simón Clemente`}
  description={post.description}
  image={post.image}
  type="article"
  publishedTime={post.publishDate}
  jsonLd={graph(website(), blogPosting(entry))}
  markdown={`/blog/${entry.slug}.md`}
>
  <main class="window reader-window" data-post>
    <Reader
      file={file}
      title={post.title}
      titleId="post-title"
      lead={post.description}
      image={post.image}
      scrollLabel="Texto del post"
      toc={toc(headings)}
      frontmatter={[
        { key: 'fecha', value: { text: fecha, datetime: post.publishDate.toISOString() } },
        { key: 'lectura', value: `${minutes} min` },
        { key: 'tags', value: post.tags.map((tag) => ({ label: tag, href: `/blog?q=${encodeURIComponent(tag)}` })) },
      ]}
      pager={{ href: '/blog', label: '← blog', info: `${minutes} min de lectura` }}
    >
      <Content />
      {
        post.series && (
          <nav slot="after" class="toc series" aria-label={`Serie ${post.series.name}`}>
            <p class="toc-title">
              serie {post.series.name}, parte {post.series.part} de {series.length}
            </p>
            <ol>
              {series.map((part, i) => (
                <li>
                  <span class="branch">{i === series.length - 1 ? '└── ' : '├── '}</span>
                  {part.id === entry.id ? (
                    <span aria-current="page">{part.data.title} (estás aquí)</span>
                  ) : (
                    <a href={`/blog/${part.slug}`}>{part.data.title}</a>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <script
        slot="after"
        src="https://giscus.app/client.js"
        data-repo="simoncra/portfolio_v2"
        data-repo-id="R_kgDOKPAG8g"
        data-category="General"
        data-category-id="DIC_kwDOKPAG8s4CZFkZ"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="gruvbox_dark"
        data-lang="es"
        data-loading="lazy"
        crossorigin="anonymous"
        async
        data-astro-rerun
      ></script>
    </Reader>
  </main>
</SessionLayout>
