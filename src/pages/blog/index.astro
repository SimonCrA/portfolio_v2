---
import SessionLayout from '../../layouts/SessionLayout.astro'
import { fmtDate } from '../../session/date'
import PixelArt from '../../components/session/PixelArt.astro'
import { KIND_ICON } from '../../session/icons'
import { getSortedPosts } from '../../session/posts'

const posts = await getSortedPosts()
// Suggested topics for the empty state: the 3 most common Tags.
const tagCount = new Map<string, number>()
for (const t of posts.flatMap((p) => p.data.tags)) tagCount.set(t, (tagCount.get(t) ?? 0) + 1)
const topTags = [...tagCount].sort((a, b) => b[1] - a[1]).slice(0, 3).map(([t]) => t)
---

<SessionLayout current="blog" title="Blog | Simonctech" description="Posts de Simón sobre lo que construye y aprende.">
  <main class="window">
    <section class="pane is-active" aria-labelledby="pane-blog">
      <h2 class="pane-title" id="pane-blog">blog</h2>
      <p class="prompt-line">
        <span class="user">simon@simonctech</span>:<span class="path">~</span>$ <span class="cmd" data-cmd>ls -lt blog/</span>
      </p>
      <div class="pane-scroll" data-scroll tabindex="0" aria-label="Lista de posts">
        <ol class="list" data-list data-searchable>
          {
            posts.map((post) => (
              <li data-search={[post.data.title, post.data.description, ...post.data.tags].join(' ')}>
                <a class="row" href={`/blog/${post.slug}`}>
                  <PixelArt name={KIND_ICON.post} scale={2} />
                  <span class="main">
                    <span class="title">{post.data.title}</span>
                    <span class="summary">{post.data.description}</span>
                    <span class="tags">{post.data.tags.map((t) => `#${t}`).join(' ')}</span>
                  </span>
                  <span class="meta">
                    <span class="kind">post</span>
                    <time datetime={post.data.publishDate.toISOString()}>{fmtDate(post.data.publishDate)}</time>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
        <p class="empty" data-empty hidden>
          Ningún post coincide con «<span data-empty-q></span>». Prueba con un tema como
          {topTags.map((t, i) => (<><code>{t}</code>{i < topTags.length - 2 ? ', ' : i === topTags.length - 2 ? ' o ' : ''}</>))},
          o escribe <code>:buscar</code> sin texto para ver todos.
        </p>
      </div>
    </section>
  </main>
</SessionLayout>

<style>
  .list {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }
  .empty {
    color: var(--dim);
    margin: 16px 0;
  }
  .row {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr) auto;
    gap: 0 12px;
    align-items: start;
    padding: 10px 6px;
    border-left: 2px solid transparent;
    text-decoration: none;
  }
  .row:hover,
  .row:focus-visible {
    border-left-color: var(--accent);
    background: var(--bg-2);
  }
  .main {
    display: grid;
    gap: 2px;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .title {
    font-weight: 700;
  }
  .row:hover .title {
    color: var(--accent);
  }
  .summary {
    color: var(--dim);
    font-size: 0.9rem;
  }
  .tags {
    color: var(--blue);
    font-size: 0.8667rem;
  }
  .meta {
    display: grid;
    justify-items: end;
    font-size: 0.8667rem;
    white-space: nowrap;
  }
  .kind {
    color: var(--aqua);
  }
  time {
    color: var(--dim);
  }
  @media (max-width: 560px) {
    .meta {
      grid-column: 2;
      grid-row: 2;
      display: flex;
      gap: 10px;
    }
  }
</style>
