---
import SessionLayout from '../layouts/SessionLayout.astro'
import Navigator from '../components/session/Navigator.astro'
import LatestFeed from '../components/session/LatestFeed.astro'
import Banner from '../components/session/Banner.astro'
import { getAbout } from '../session/getAbout'

const about = (await getAbout()).data

const prompt = (cmd: string) => `<span class="user">simon@simonctech</span>:<span class="path">~</span>$ <span class="cmd">${cmd}</span>`
---

<SessionLayout current="inicio">
  <main class="window window-home">
    <section class="pane pane-zsh is-active" aria-label="Simonctech: quién soy">
      <h2 class="pane-title">zsh</h2>
      <Banner />
      <p class="prompt-line" set:html={prompt('whoami')} />
      <div class="out"><h1 class="name">{about.name}</h1>. {about.intro}</div>
      <p class="prompt-line" set:html={prompt('cat ahora.txt')} />
      <p class="out" data-now>{about.now}</p>
      <button type="button" class="prompt-line live" data-open-prompt aria-label="Abrir el prompt de comandos">
        <span set:html={prompt('')} /><span class="cursor" aria-hidden="true"></span>
        <span class="live-hint">pulsa <kbd>:</kbd> para escribir un comando o <kbd>?</kbd> para la ayuda</span>
      </button>
    </section>

    <Navigator />
    <LatestFeed />
  </main>
</SessionLayout>

<style>
  .window-home {
    align-content: start;
  }
  @media (min-width: 900px) {
    /* The home window fills the viewport exactly; long content scrolls inside its pane. */
    .window-home {
      flex: none;
      box-sizing: border-box;
      height: calc(100dvh - var(--status-h));
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
    }
    /* Left column: zsh, then the navigator. The right column is reserved for the Latest feed (#10). */
    .window-home :global(.pane-zsh),
    .window-home :global(.pane-nav) {
      grid-column: 1;
    }
    .window-home :global(.pane-latest) {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
  @media (max-width: 899px) {
    /* Phone order: zsh, últimos, navigator. */
    .window-home :global(.pane-latest) {
      order: 1;
    }
    .window-home :global(.pane-nav) {
      order: 2;
    }
  }
  /* The page heading reads as the first words of the whoami output. */
  .name {
    display: inline;
    margin: 0;
    color: var(--accent);
    font-size: inherit;
    line-height: inherit;
  }
</style>
