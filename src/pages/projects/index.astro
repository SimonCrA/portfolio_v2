---
// Window 1: the Projects as an `eza -l --icons` listing. Featured first, then newest (see
// src/session/projects.ts). The status reads like `systemctl status`: a coloured dot and a word.
import SessionLayout from '../../layouts/SessionLayout.astro'
import PixelArt from '../../components/session/PixelArt.astro'
import { PROJECT_ICON } from '../../session/icons'
import { fmtDate } from '../../session/date'
import { getSortedProjects } from '../../session/projects'

const projects = await getSortedProjects()
---

<SessionLayout current="proyectos" title="Proyectos | Simonctech" description="Lo que Simón ha construido, software y hardware.">
  <main class="window">
    <section class="pane is-active" aria-labelledby="pane-proyectos">
      <h2 class="pane-title" id="pane-proyectos">proyectos</h2>
      <p class="prompt-line">
        <span class="user">simon@simonctech</span>:<span class="path">~</span>$ <span class="cmd" data-cmd>eza -l --icons proyectos/</span>
      </p>
      <div class="pane-scroll" data-scroll tabindex="0" aria-label="Lista de proyectos">
        {
          projects.length > 0 && (
            <ol class="list" data-list data-searchable>
              {projects.map(({ slug, data: p }) => (
                <li data-search={[p.title, p.summary, p.kind, p.status, ...p.tags, ...p.stack].join(' ')}>
                  <a class="row" href={`/projects/${slug}`} data-featured={p.featured ? '' : undefined}>
                    <PixelArt name={PROJECT_ICON[p.kind]} scale={2} />
                    <span class="main">
                      <span class="title">
                        {p.featured && (
                          <span class="star" aria-label="Destacado">
                            ★
                          </span>
                        )}
                        {p.title}</span>
                      <span class="summary">{p.summary}</span>
                      <span class="stack">{p.stack.join('  ')}</span>
                    </span>
                    <span class="meta">
                      <span class={`state state-${p.status}`}>{p.status}</span>
                      <span class="kind">{p.kind}</span>
                      <time datetime={p.date.toISOString()}>{fmtDate(p.date)}</time>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          )
        }
        <p class="out empty" data-empty hidden={projects.length > 0}>
          {
            projects.length > 0 ? (
              <>
                Ningún proyecto coincide con «<span data-empty-q />». Escribe <code>:buscar</code> sin texto para verlos todos.
              </>
            ) : (
              <>Todavía no hay proyectos publicados. Mientras tanto, el blog tiene lo último que he escrito.</>
            )
          }
        </p>
      </div>
    </section>
  </main>
</SessionLayout>

<style>
  .list {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }
  .empty {
    margin: 16px 0;
    color: var(--dim);
  }
  .row {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr) auto;
    gap: 0 12px;
    align-items: start;
    padding: 10px 6px;
    border-left: 2px solid transparent;
    text-decoration: none;
  }
  .row:hover,
  .row:focus-visible {
    border-left-color: var(--accent);
    background: var(--bg-2);
  }
  .main {
    display: grid;
    gap: 2px;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .title {
    color: var(--blue);
    font-weight: 700;
  }
  .title::after {
    content: '/';
  }
  .row:hover .title {
    color: var(--accent);
  }
  .star {
    margin-right: 1ch;
    color: var(--accent);
  }
  .summary {
    color: var(--fg);
    font-size: 0.9rem;
  }
  .stack {
    color: var(--dim);
    font-size: 0.8667rem;
    white-space: pre-wrap;
  }
  .meta {
    display: grid;
    justify-items: end;
    font-size: 0.8667rem;
    white-space: nowrap;
  }
  /* Like `systemctl status`: the dot carries the state's colour. */
  .state::before {
    content: '● ';
  }
  .state-activo {
    color: var(--green);
  }
  .state-terminado {
    color: var(--blue);
  }
  .state-archivado {
    color: var(--dim);
  }
  .kind {
    color: var(--purple);
  }
  time {
    color: var(--dim);
  }
  @media (max-width: 560px) {
    .meta {
      grid-column: 2;
      grid-row: 2;
      display: flex;
      flex-wrap: wrap;
      gap: 0 12px;
    }
  }
</style>
