{
  "headers": [
    {
      "source": "/(.*)\\.md",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/index.md",
      "headers": [{ "key": "Link", "value": "<https://www.simonctech.com/>; rel=\"canonical\"" }]
    },
    {
      "source": "/:path((?!index$|sitemap$).+)\\.md",
      "headers": [{ "key": "Link", "value": "<https://www.simonctech.com/:path/>; rel=\"canonical\"" }]
    }
  ]
}
